{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapter Metadata Schema",
  "description": "Schema for validating chapter front-matter metadata.",
  "type": "object",
  "required": [
    "id",
    "title",
    "module",
    "order",
    "difficulty",
    "prerequisites",
    "tags",
    "languageVariants"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the chapter (e.g., chapter-1-ros2-basics)"
    },
    "title": {
      "type": "string",
      "description": "Title of the chapter"
    },
    "module": {
      "type": "string",
      "description": "Reference to the parent module's ID"
    },
    "order": {
      "type": "integer",
      "description": "Sequential order within its module"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Difficulty level of the chapter"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of prerequisites (e.g., 'Python Basics', 'Module 1 - Chapter 1')"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tags/keywords for the chapter"
    },
    "personalizationFlags": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": ["string", "boolean", "number", "array", "object"]
        }
      },
      "description": "Key-value pairs for personalization settings"
    },
    "languageVariants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["en", "ur"]
      },
      "description": "Supported language variants for the chapter (e.g., ['en', 'ur'])"
    },
    "assetReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to diagrams, code snippets, etc., used in the chapter"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of authors for this specific chapter"
    },
    "version": {
      "type": "string",
      "description": "Version of this specific chapter"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update date (ISO 8601 format)"
    }
  },
  "additionalProperties": false
}